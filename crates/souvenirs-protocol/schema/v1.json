            "unresolved_item_count": {
              "type": "integer",
              "format": "uint",
              "minimum": 0.0
            },
            "unsupported_count": {
              "type": "integer",
              "format": "uint",
              "minimum": 0.0
            },
            "video_count": {
              "type": "integer",
              "format": "uint",
              "minimum": 0.0
            }
          }
