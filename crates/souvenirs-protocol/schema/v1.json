              ],
              "properties": {
                "completed_units": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0.0
                },
                "event": {
                  "type": "string",
                  "enum": [
                    "progress"
                  ]
                },
                "message": {
                  "type": [
                    "string",
