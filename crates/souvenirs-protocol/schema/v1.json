            "operation_count": {
              "type": "integer",
              "format": "uint",
              "minimum": 0.0
            },
            "required_decision_count": {
              "type": "integer",
              "format": "uint",
              "minimum": 0.0
            },
            "required_space_bytes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "scan": {
              "$ref": "#/definitions/ImportScanResult"
