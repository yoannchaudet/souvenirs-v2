          "type": "object",
          "required": [
            "accepted_date",
            "catalog_path",
            "collection_name",
            "destination_mode",
            "name",
            "source_path"
          ],
          "properties": {
            "accepted_date": {
              "type": "string"
            },
            "catalog_path": {
              "type": "string"
            },
            "collection_name": {
