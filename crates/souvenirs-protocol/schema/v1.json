            {
              "type": "object",
              "required": [
                "event",
                "result"
              ],
              "properties": {
                "event": {
                  "type": "string",
                  "enum": [
                    "completed"
                  ]
                },
                "result": true
              }
            },
            {
              "type": "object",
              "required": [
                "error",
                "event"
              ],
              "properties": {
                "error": {
                  "$ref": "#/definitions/ProtocolError"
                },
                "event": {
                  "type": "string",
                  "enum": [
                    "failed"
                  ]
                }
              }
            },
            {
              "type": "object",
              "required": [
                "event"
              ],
              "properties": {
                "event": {
                  "type": "string",
                  "enum": [
                    "cancelled"
