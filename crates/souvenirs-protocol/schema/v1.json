        },
        {
          "type": "object",
          "required": [
            "method",
            "params"
          ],
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "import.scan"
              ]
            },
            "params": {
              "$ref": "#/definitions/ImportScanParameters"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "method",
            "params"
          ],
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "import.review"
              ]
            },
            "params": {
              "$ref": "#/definitions/ImportReviewParameters"
            }
          }
        },
        {
          "type": "object",
          "required": [
