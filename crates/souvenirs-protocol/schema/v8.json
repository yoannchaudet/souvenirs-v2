                "status": {
                  "type": "string",
                  "enum": [
                    "success"
                  ]
                }
              }
            },
            {
              "type": "object",
              "required": [
                "error",
                "status"
              ],
              "properties": {
                "error": {
                  "$ref": "#/definitions/ProtocolError"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "error"
                  ]
                }
              }
            }
          ],
          "required": [
            "kind",
            "protocol_version"
          ],
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "response"
              ]
            },
            "protocol_version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          }
        },
        {
          "type": "object",
          "oneOf": [
            {
              "type": "object",
              "required": [
                "event",
                "name"
