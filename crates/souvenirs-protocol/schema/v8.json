        "converted_from_utc_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "item_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "requires_clock": {
          "default": false,
          "type": "boolean"
        },
        "source": {
          "$ref": "#/definitions/ImportDateSource"
        },
        "state": {
          "$ref": "#/definitions/ImportDateState"
        },
        "supports_utc_conversion": {
          "default": false,
          "type": "boolean"
        }
      }
    },
