          "properties": {
            "end_date": {
              "type": "string"
            },
            "identity": {
              "$ref": "#/definitions/CatalogCollectionIdentity"
            },
            "kind": {
              "type": "string",
              "enum": [
                "dated"
              ]
            },
            "label": {
              "type": "string"
            },
            "start_date": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "identity",
            "kind",
            "label",
            "parts"
          ],
          "properties": {
            "identity": {
              "$ref": "#/definitions/CatalogCollectionIdentity"
            },
            "kind": {
              "type": "string",
              "enum": [
                "ongoing"
              ]
            },
            "label": {
              "type": "string"
            },
            "parts": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/CatalogCollectionPart"
              }
            }
          }
        }
      ]
