                "name": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "completed_units",
                "event"
              ],
              "properties": {
                "completed_units": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0.0
                },
                "event": {
                  "type": "string",
                  "enum": [
                    "progress"
                  ]
                },
                "message": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "total_units": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "uint64",
                  "minimum": 0.0
                }
              }
            },
            {
              "type": "object",
              "required": [
                "event",
                "result"
              ],
              "properties": {
                "event": {
                  "type": "string",
                  "enum": [
                    "completed"
                  ]
                },
                "result": true
              }
            },
            {
              "type": "object",
              "required": [
                "error",
                "event"
              ],
              "properties": {
                "error": {
                  "$ref": "#/definitions/ProtocolError"
                },
                "event": {
                  "type": "string",
                  "enum": [
                    "failed"
                  ]
                }
              }
            },
