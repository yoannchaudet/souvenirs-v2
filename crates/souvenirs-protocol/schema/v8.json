        "source_path": {
          "type": "string"
        },
        "suggested_accepted_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "suggested_collection_name": {
          "type": "string"
        },
        "suggested_range_end": {
          "type": [
            "string",
            "null"
          ]
        },
        "total_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "uncertain_time_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "unresolved_item_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "unsupported_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "video_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        }
      }
