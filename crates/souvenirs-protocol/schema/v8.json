        "file_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "media_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "pending_item_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "photo_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "source_name": {
          "type": "string"
